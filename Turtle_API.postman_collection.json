{
	"info": {
		"_postman_id": "turtle-api-collection",
		"name": "Turtle Delivery API",
		"description": "Complete GraphQL API collection for Turtle delivery and ride-sharing platform",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "1. Request OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"OTP sent successfully\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.requestOTP.success).to.eql(true);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "mutation RequestOTP($phone: String!, $purpose: OTPPurpose!) {\n  requestOTP(input: {\n    phone: $phone\n    purpose: $purpose\n  }) {\n    success\n    message\n    target\n    expiresAt\n  }\n}",
								"variables": "{\n  \"phone\": \"+1234567890\",\n  \"purpose\": \"LOGIN\"\n}"
							}
						},
						"url": {
							"raw": "{{baseUrl}}",
							"host": ["{{baseUrl}}"]
						}
					}
				},
				{
					"name": "2. Verify OTP & Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Save tokens\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"accessToken\", jsonData.data.verifyOTP.tokens.accessToken);",
									"    pm.environment.set(\"refreshToken\", jsonData.data.verifyOTP.tokens.refreshToken);",
									"    pm.environment.set(\"userId\", jsonData.data.verifyOTP.user.id);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "mutation VerifyOTP($phone: String!, $code: String!, $purpose: OTPPurpose!, $deviceType: DeviceType!, $deviceInfo: String!) {\n  verifyOTP(input: {\n    phone: $phone\n    code: $code\n    purpose: $purpose\n    deviceType: $deviceType\n    deviceInfo: $deviceInfo\n  }) {\n    tokens {\n      accessToken\n      refreshToken\n      expiresAt\n      tokenType\n    }\n    user {\n      id\n      firstName\n      lastName\n      phone\n      role\n      status\n    }\n    isNewUser\n  }\n}",
								"variables": "{\n  \"phone\": \"+1234567890\",\n  \"code\": \"123456\",\n  \"purpose\": \"LOGIN\",\n  \"deviceType\": \"WEB\",\n  \"deviceInfo\": \"Postman\"\n}"
							}
						},
						"url": {
							"raw": "{{baseUrl}}",
							"host": ["{{baseUrl}}"]
						}
					}
				},
				{
					"name": "3. Get Current User (Me)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "query Me {\n  me {\n    id\n    firstName\n    lastName\n    email\n    phone\n    phoneVerified\n    role\n    status\n    profilePic\n    createdAt\n    updatedAt\n  }\n}"
							}
						},
						"url": {
							"raw": "{{baseUrl}}",
							"host": ["{{baseUrl}}"]
						}
					}
				},
				{
					"name": "4. Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Save new token\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"accessToken\", jsonData.data.refreshToken.accessToken);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "mutation RefreshToken($refreshToken: String!) {\n  refreshToken(input: { refreshToken: $refreshToken }) {\n    accessToken\n    refreshToken\n    expiresAt\n    tokenType\n  }\n}",
								"variables": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
							}
						},
						"url": {
							"raw": "{{baseUrl}}",
							"host": ["{{baseUrl}}"]
						}
					}
				},
