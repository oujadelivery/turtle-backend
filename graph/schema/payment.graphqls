extend type Query {
  # Get wallet balance
  myWallet: Wallet!

  # Get transaction history
  myTransactions(
    type: TransactionType
    pagination: PaginationInput
  ): TransactionConnection!

  # Get transaction by ID
  transaction(id: Int!): Transaction

  # Get available coupons
  availableCoupons: [Coupon!]!

  # Validate coupon
  validateCoupon(code: String!, orderValue: Float!): CouponValidation!

  # Captain earnings
  myCaptainEarnings(startDate: Time!, endDate: Time!): EarningsSummary!
  captainEarningsByDate(date: Time!): CaptainEarnings
}

extend type Mutation {
  # Wallet operations
  addMoneyToWallet(amount: Float!, paymentMethod: PaymentMethod!): Transaction!
  withdrawFromWallet(amount: Float!): Transaction!

  # Payment for order
  processOrderPayment(
    orderId: Int!
    paymentMethod: PaymentMethod!
  ): Transaction!

  # Refund
  requestRefund(orderId: Int!, reason: String!): Transaction!

  # Coupons (admin)
  createCoupon(input: CreateCouponInput!): Coupon!
  updateCoupon(id: Int!, input: UpdateCouponInput!): Coupon!
  deactivateCoupon(id: Int!): Coupon!
}

enum TransactionType {
  ORDER_PAYMENT
  REFUND
  WALLET_TOPUP
  WITHDRAWAL
  COMMISSION
  BONUS
  TIP
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

type Wallet {
  balance: Float!
  currency: String!
  lastUpdated: Time!
  pendingAmount: Float!
}

type Transaction {
  id: Int!
  transactionId: String!
  userId: Int!
  orderId: Int

  type: TransactionType!
  amount: Float!
  currency: String!

  balanceBefore: Float!
  balanceAfter: Float!

  paymentMethod: PaymentMethod
  paymentGateway: String
  gatewayOrderId: String
  gatewayPaymentId: String

  status: TransactionStatus!
  description: String

  processedAt: Time
  failedAt: Time
  failureReason: String

  createdAt: Time!
}

type TransactionConnection {
  edges: [Transaction!]!
  pageInfo: PaginationInfo!
}

type Coupon {
  id: Int!
  code: String!
  description: String
  type: CouponType!
  value: Float!

  minOrderValue: Float!
  maxDiscountValue: Float!
  usageLimit: Int!
  usageCount: Int!
  perUserLimit: Int!

  validFrom: Time!
  validUntil: Time!
  isActive: Boolean!

  isPublic: Boolean!
  firstOrderOnly: Boolean!

  createdAt: Time!
}

type CouponValidation {
  isValid: Boolean!
  message: String
  discountAmount: Float
  finalAmount: Float
}

type EarningsSummary {
  totalEarnings: Float!
  platformFee: Float!
  netEarnings: Float!
  tipsReceived: Float!
  bonusEarnings: Float!

  totalOrders: Int!
  completedOrders: Int!
  cancelledOrders: Int!
  totalDistance: Float!
  onlineHours: Float!
  averageRating: Float!

  dailyBreakdown: [CaptainEarnings!]!
}

type CaptainEarnings {
  id: Int!
  captainId: Int!
  date: Time!

  totalEarnings: Float!
  platformFee: Float!
  netEarnings: Float!
  tipsReceived: Float!
  bonusEarnings: Float!

  totalOrders: Int!
  completedOrders: Int!
  cancelledOrders: Int!
  totalDistance: Float!
  onlineHours: Float!
  averageRating: Float!
}

input CreateCouponInput {
  code: String!
  description: String
  type: CouponType!
  value: Float!

  minOrderValue: Float = 0
  maxDiscountValue: Float = 0
  usageLimit: Int = 0
  perUserLimit: Int = 1

  validFrom: Time!
  validUntil: Time!

  isPublic: Boolean = true
  firstOrderOnly: Boolean = false
}

input UpdateCouponInput {
  description: String
  value: Float

  minOrderValue: Float
  maxDiscountValue: Float
  usageLimit: Int

  validFrom: Time
  validUntil: Time

  isActive: Boolean
}
