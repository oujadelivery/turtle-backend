extend type Query {
  # Get chat room for order
  chatRoom(orderId: Int!): ChatRoom

  # Get chat messages
  chatMessages(
    roomId: Int!
    pagination: PaginationInput
  ): ChatMessageConnection!

  # Get unread message count
  unreadMessageCount: Int!
}

extend type Mutation {
  # Send message
  sendMessage(input: SendMessageInput!): ChatMessage!

  # Mark message as read
  markMessageAsRead(messageId: Int!): ChatMessage!

  # Mark all messages as read
  markAllMessagesAsRead(roomId: Int!): SuccessResponse!
}

extend type Subscription {
  # Subscribe to new messages
  messageReceived(roomId: Int!): ChatMessage!

  # Subscribe to typing indicator
  userTyping(roomId: Int!): TypingIndicator!
}

type ChatRoom {
  id: Int!
  orderId: Int!
  customerId: Int!
  captainId: Int!
  isActive: Boolean!
  lastMessageAt: Time

  order: Order!
  customer: User!
  captain: User!
  messages: [ChatMessage!]!

  createdAt: Time!
}

type ChatMessage {
  id: Int!
  roomId: Int!
  senderId: Int!
  receiverId: Int!

  message: String!
  messageType: MessageType!

  isRead: Boolean!
  readAt: Time
  deliveredAt: Time

  mediaURL: String
  thumbnailURL: String

  latitude: Float
  longitude: Float

  sender: User!
  receiver: User!

  createdAt: Time!
}

type ChatMessageConnection {
  edges: [ChatMessage!]!
  pageInfo: PaginationInfo!
}

type TypingIndicator {
  roomId: Int!
  userId: Int!
  isTyping: Boolean!
}

enum MessageType {
  TEXT
  IMAGE
  LOCATION
  AUDIO
}

input SendMessageInput {
  roomId: Int!
  receiverId: Int!
  message: String!
  messageType: MessageType = TEXT
  mediaURL: String
  latitude: Float
  longitude: Float
}
