extend type Query {
  # Get my notifications
  myNotifications(
    isRead: Boolean
    pagination: PaginationInput
  ): NotificationConnection!

  # Get unread count
  unreadNotificationCount: Int!
}

extend type Mutation {
  # Mark notification as read
  markNotificationAsRead(id: Int!): Notification!

  # Mark all as read
  markAllNotificationsAsRead: SuccessResponse!

  # Delete notification
  deleteNotification(id: Int!): SuccessResponse!

  # Update device token for push notifications
  updateDeviceToken(token: String!, platform: DevicePlatform!): SuccessResponse!
}

extend type Subscription {
  # Subscribe to notifications
  notificationReceived: Notification!
}

enum NotificationType {
  ORDER_UPDATE
  PROMOTION
  PAYMENT
  SYSTEM
  RATING
  SUPPORT
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

type Notification {
  id: Int!
  userId: Int!

  title: String!
  message: String!
  type: NotificationType!

  orderId: Int
  transactionId: Int

  isRead: Boolean!
  readAt: Time
  isSent: Boolean!
  sentAt: Time

  actionURL: String
  data: JSON

  createdAt: Time!
}

type NotificationConnection {
  edges: [Notification!]!
  pageInfo: PaginationInfo!
}
