extend type Query {
  # Get my support tickets
  myTickets(
    status: TicketStatus
    pagination: PaginationInput
  ): TicketConnection!

  # Get ticket by ID
  ticket(id: Int!): SupportTicket

  # Get ticket by number
  ticketByNumber(ticketNumber: String!): SupportTicket

  # Admin: Get all tickets
  allTickets(
    status: TicketStatus
    priority: TicketPriority
    pagination: PaginationInput
  ): TicketConnection!
}

extend type Mutation {
  # Create support ticket
  createTicket(input: CreateTicketInput!): SupportTicket!

  # Add message to ticket
  addTicketMessage(
    ticketId: Int!
    message: String!
    attachments: [String!]
  ): SupportTicket!

  # Close ticket
  closeTicket(ticketId: Int!): SupportTicket!

  # Admin: Assign ticket
  assignTicket(ticketId: Int!, adminId: Int!): SupportTicket!

  # Admin: Update ticket status
  updateTicketStatus(
    ticketId: Int!
    status: TicketStatus!
    message: String
  ): SupportTicket!

  # Admin: Update ticket priority
  updateTicketPriority(
    ticketId: Int!
    priority: TicketPriority!
  ): SupportTicket!
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  ORDER_ISSUE
  PAYMENT
  ACCOUNT
  CAPTAIN_BEHAVIOR
  APP_BUG
  FEATURE_REQUEST
  OTHER
}

type SupportTicket {
  id: Int!
  userId: Int!
  orderId: Int

  ticketNumber: String!
  subject: String!
  description: String!
  category: TicketCategory!

  status: TicketStatus!
  priority: TicketPriority!

  assignedToAdminId: Int
  assignedToAdmin: User
  assignedAt: Time
  resolvedAt: Time

  attachments: [String!]
  messages: [TicketMessage!]

  user: User!
  order: Order

  createdAt: Time!
  updatedAt: Time!
}

type TicketMessage {
  id: Int!
  ticketId: Int!
  userId: Int!
  message: String!
  attachments: [String!]
  isStaffReply: Boolean!

  user: User!
  createdAt: Time!
}

type TicketConnection {
  edges: [SupportTicket!]!
  pageInfo: PaginationInfo!
}

input CreateTicketInput {
  orderId: Int
  subject: String!
  description: String!
  priority: String
  category: TicketCategory!
  attachments: [String!]
}
