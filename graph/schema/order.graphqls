extend type Query {
  # Get order by ID
  order(id: Int!): Order

  # Get order by order number
  orderByNumber(orderNumber: String!): Order

  # Get my orders (customer)
  myOrders(status: OrderStatus, pagination: PaginationInput): OrderConnection!

  # Get my deliveries (captain)
  myDeliveries(
    status: OrderStatus
    pagination: PaginationInput
  ): OrderConnection!

  # Get active order (for customer - only one active order at a time)
  myActiveOrder: Order

  # Get active delivery (for captain - current ongoing delivery)
  myActiveDelivery: Order

  # Get pending orders near captain (for captain to see available orders)
  nearbyOrders(
    latitude: Float!
    longitude: Float!
    radiusKm: Float = 5
  ): [Order!]!

  # Calculate price estimate
  estimatePrice(input: EstimatePriceInput!): PriceEstimate!

  # Search orders (admin)
  searchOrders(
    query: String
    status: OrderStatus
    pagination: PaginationInput
  ): OrderConnection!
}

extend type Mutation {
  # Create new order
  createOrder(input: CreateOrderInput!): Order!

  # Cancel order
  cancelOrder(orderId: Int!, reason: String!): Order!

  # Captain actions
  acceptOrder(orderId: Int!): Order!
  rejectOrder(orderId: Int!, reason: String!): Order!
  startPickup(orderId: Int!): Order!
  confirmPickup(orderId: Int!, otp: String!): Order!
  startDelivery(orderId: Int!): Order!
  completeDelivery(orderId: Int!, otp: String!, proofPhotoUrl: String): Order!

  # Schedule order
  scheduleOrder(input: ScheduleOrderInput!): Order!

  # Admin actions
  reassignOrder(orderId: Int!, captainId: Int!): Order!
  refundOrder(orderId: Int!, reason: String!): Order!
}

extend type Subscription {
  # Subscribe to order updates
  orderUpdated(orderId: Int!): Order!

  # Subscribe to captain location updates
  captainLocationUpdated(orderId: Int!): LocationUpdate!

  # Subscribe to new orders (for captains in area)
  newOrdersNearby(latitude: Float!, longitude: Float!, radiusKm: Float!): Order!
}

enum OrderStatus {
  PENDING
  ACCEPTED
  CAPTAIN_ARRIVING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ParcelType {
  DOCUMENT
  PACKAGE
  FOOD
  FRAGILE
  ELECTRONICS
  CLOTHING
  GROCERIES
  MEDICINES
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
  UPI
  NET_BANKING
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

type Order {
  id: Int!
  orderNumber: String!

  # Participants
  customerId: Int!
  customer: User!
  captainId: Int
  captain: User

  # Pickup
  pickupAddress: Address!
  pickupName: String!
  pickupPhone: String!
  pickupLat: Float!
  pickupLng: Float!
  pickupInstructions: String

  # Delivery
  deliveryAddress: Address!
  deliveryName: String!
  deliveryPhone: String!
  deliveryLat: Float!
  deliveryLng: Float!
  deliveryInstructions: String

  # Parcel
  parcelType: ParcelType!
  parcelWeight: Float
  parcelDescription: String
  parcelValue: Float
  parcelImages: [String!]

  # Distance & Time
  estimatedDistance: Float!
  actualDistance: Float
  estimatedDuration: Int!
  actualDuration: Int

  # Pricing
  basePrice: Float!
  distancePrice: Float!
  surgePrice: Float
  discountAmount: Float!
  taxAmount: Float!
  totalPrice: Float!
  captainEarnings: Float
  platformFee: Float
  currency: String!

  # Coupon
  couponCode: String
  promoDiscount: Float

  # Status
  status: OrderStatus!
  statusHistory: [StatusHistoryItem!]!

  # Timeline
  placedAt: Time!
  acceptedAt: Time
  pickupArrivedAt: Time
  pickedUpAt: Time
  deliveredAt: Time
  cancelledAt: Time

  # Cancellation
  cancellationReason: String
  cancelledBy: String

  # Verification
  pickupOTP: String
  deliveryOTP: String
  isOTPVerified: Boolean!

  # Proof
  deliveryPhoto: String
  deliverySignature: String

  # Payment
  paymentMethod: PaymentMethod!
  paymentStatus: PaymentStatus!
  paymentId: String
  paidAt: Time

  # Rating
  customerRating: Float
  captainRating: Float
  customerFeedback: String
  captainFeedback: String

  # Tracking
  trackingURL: String
  currentLocation: Location

  # Schedule
  isScheduled: Boolean!
  scheduledPickupAt: Time

  # Priority
  isPriority: Boolean!

  # Insurance
  isInsured: Boolean!
  insuranceAmount: Float

  createdAt: Time!
  updatedAt: Time!
}

type OrderConnection {
  edges: [Order!]!
  pageInfo: PaginationInfo!
}

type StatusHistoryItem {
  status: OrderStatus!
  timestamp: Time!
  note: String
}

type PriceEstimate {
  basePrice: Float!
  distancePrice: Float!
  surgeMultiplier: Float!
  surgePrice: Float!
  discountAmount: Float!
  taxAmount: Float!
  estimatedTotal: Float!
  estimatedDistance: Float!
  estimatedDuration: Int!
  currency: String!
}

type LocationUpdate {
  orderId: Int!
  captainId: Int!
  latitude: Float!
  longitude: Float!
  speed: Float
  bearing: Float
  timestamp: Time!
}

input CreateOrderInput {
  # Pickup
  pickupAddressId: Int!
  pickupName: String!
  pickupPhone: String!
  pickupInstructions: String

  # Delivery
  deliveryAddressId: Int!
  deliveryName: String!
  deliveryPhone: String!
  deliveryInstructions: String

  # Parcel
  parcelType: ParcelType!
  parcelWeight: Float
  parcelDescription: String
  parcelValue: Float
  parcelImages: [String!]

  # Payment
  paymentMethod: PaymentMethod!
  couponCode: String

  # Options
  isPriority: Boolean = false
  isInsured: Boolean = false
}

input ScheduleOrderInput {
  orderInput: CreateOrderInput!
  scheduledPickupAt: Time!
}

input EstimatePriceInput {
  pickupLat: Float!
  pickupLng: Float!
  deliveryLat: Float!
  deliveryLng: Float!
  parcelType: ParcelType!
  parcelWeight: Float
  isPriority: Boolean = false
  couponCode: String
}
