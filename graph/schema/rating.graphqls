extend type Query {
  # Get ratings for a user
  userRatings(userId: Int!, pagination: PaginationInput): RatingConnection!

  # Get rating for specific order
  orderRating(orderId: Int!): Rating

  # Get my received ratings
  myReceivedRatings(pagination: PaginationInput): RatingConnection!

  # Get my given ratings
  myGivenRatings(pagination: PaginationInput): RatingConnection!
}

extend type Mutation {
  # Rate a user after order completion
  rateUser(input: RateUserInput!): Rating!

  # Update rating (within 24 hours)
  updateRating(ratingId: Int!, input: UpdateRatingInput!): Rating!

  # Flag inappropriate rating (admin)
  flagRating(ratingId: Int!, reason: String!): Rating!
  unflagRating(ratingId: Int!): Rating!
}

type Rating {
  id: Int!
  orderId: Int!
  userId: Int!
  ratedUserId: Int!

  rating: Float!
  behaviorRating: Float
  timelinessRating: Float
  communicationRating: Float
  parcelConditionRating: Float

  comment: String
  tags: [String!]

  isFlagged: Boolean!
  flagReason: String

  reviewer: User!
  reviewedUser: User!
  order: Order!

  createdAt: Time!
  updatedAt: Time!
}

type RatingConnection {
  edges: [Rating!]!
  pageInfo: PaginationInfo!
}

input RateUserInput {
  orderId: Int!
  ratedUserId: Int!

  rating: Float!
  behaviorRating: Float
  timelinessRating: Float
  communicationRating: Float
  parcelConditionRating: Float

  comment: String
  tags: [String!]
}

input UpdateRatingInput {
  rating: Float
  behaviorRating: Float
  timelinessRating: Float
  communicationRating: Float
  parcelConditionRating: Float

  comment: String
  tags: [String!]
}
